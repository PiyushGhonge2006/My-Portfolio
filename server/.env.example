# ========================================
# PORTFOLIO BACKEND - ENVIRONMENT VARIABLES
# ========================================
# This file is a TEMPLATE. Copy it to `.env`:
#
#   Copy this file and rename the copy to  `.env`
#   Then fill in your ACTUAL values below.
#
# DO NOT commit the real `.env` to GitHub.
# ========================================

# MongoDB Atlas connection string.
# Get it from: cloud.mongodb.com  ->  Data Services  ->  Connect  ->  Drivers
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio

# Used to sign login tokens. Use a long random string.
JWT_SECRET=change_this_to_a_long_random_string

# The admin panel login account (created by the seed script)
ADMIN_NAME=Piyush
ADMIN_EMAIL=pranayghonge2006@gmail.com
ADMIN_PASSWORD=change_this_to_a_strong_password

# Server port (defaults to 5000 if unset)
PORT=5000

# Frontend origin allowed by CORS (optional)
CLIENT_URL=http://localhost:5173

# Gmail SMTP sender (the account the App Password belongs to)
EMAIL_FROM=your_sender_gmail@gmail.com
# 16-character Gmail App Password (myaccount.google.com/apppasswords)
EMAIL_PASS=abcd_efgh_ijkl_mnop
# Where contact-form messages are delivered
CONTACT_EMAIL=pranayghonge2006@gmail.com